{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "ignoreUnstable": true,
  "automerge": false,
  "dependencyDashboard": false,
  "packageRules": [
    {
      "description": "Hold npm at 11. npm 12 requires Node ^22.22.2 || ^24.15.0 || >=26.0.0, but CI/fleet install one packageManager on every baseline, including Node 20 and 22.19.0.",
      "matchPackageNames": ["npm"],
      "allowedVersions": "<12"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^host-targets\\.json$/"],
      "matchStrings": ["\"official\": \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "@earendil-works/pi-coding-agent",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^host-targets\\.json$/"],
      "matchStrings": ["\"forkRef\": \"(?<currentDigest>[a-f0-9]{40})\""],
      "depNameTemplate": "fitchmultz/pi",
      "packageNameTemplate": "https://github.com/fitchmultz/pi",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ]
}
