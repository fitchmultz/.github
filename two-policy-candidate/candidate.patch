diff --git a/Users/mitchfultz/Library/Caches/pi-runs/atb-harness/extension-compatibility-20260920/implementation/logs/browser-two-policy-failures/candidate/test/agent-browser.windows-stock-launcher.test.ts b/test/agent-browser.windows-stock-launcher.test.ts
